# Model API (OpenAI-compatible)
OPENAI_API_KEY=replace-with-your-key
# Optional for OpenAI; required for compatible providers
OPENAI_API_BASE=https://api.openai.com/v1
# Model used by baseline rollout and OmniSeeker unless overridden by CLI
MODEL_NAME=gpt-4o
# Optional judge model for examples/eval_rollout_results.py
JUDGE_MODEL=gpt-4o

# Runtime controls
NUM_ROLLOUTS=2
MAX_TURNS=20
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
TASK_EXECUTION_TIMEOUT=600

# OmniSeeker search tools
SERPER_API_KEY=replace-with-serper-key
JINA_API_KEY=replace-with-jina-key
SEARCH_TOOLS_DEFAULT_K=5
SEARCH_TOOLS_DEFAULT_IMAGE_K=5
SEARCH_TOOLS_DEFAULT_REGION=us
SEARCH_TOOLS_REQUEST_TIMEOUT=60
SEARCH_TOOLS_MAX_RETRIES=3
SEARCH_TOOLS_RETRY_SLEEP=1.5
# Tool-returned image message format: url or base64
SEARCH_IMAGE_MESSAGE_FORMAT=url
# Keep local temporary crop/cache images for debugging
SEARCH_KEEP_CACHE=false
SEARCH_PREFETCH_IMAGES=false
SEARCH_PREFETCH_CONCURRENCY=5
IMAGE_DOWNLOAD_CONNECT_TIMEOUT=10
IMAGE_DOWNLOAD_READ_TIMEOUT=30
IMAGE_DOWNLOAD_MAX_RETRIES=3

# Reverse image search upload backend (Cloudflare R2)
SEARCH_STORAGE_MODE=cloud
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=replace-with-bucket-name
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://your-public-domain.example.com
CLOUDFLARE_R2_PREFIX=browsecomp-v3

# Unified local paths
SEARCH_LOG_DIR=omniseeker/logs
IMAGE_DOWNLOAD_LOG_DIR=omniseeker/logs/image_downloads

# Cache controls
MMDEEPSEARCH_CACHE_DB=.cache/search_cache.db
CACHE_TTL_JINA_READER_SECONDS=3600
CACHE_TTL_IMAGE_SEARCH_SECONDS=86400
CACHE_TTL_DYNAMIC_QUERY_SECONDS=900
CACHE_TTL_ERROR_SECONDS=120
